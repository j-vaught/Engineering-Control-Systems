\newcounter{re}
\numberwithin{re}{section}
\newenvironment{review}[1][]{
  \refstepcounter{re}
  \begin{tcolorbox}[
    enhanced,
    breakable,
    sharp corners,
    colback=ReviewSurface,
    colframe=CoolGrey,
    boxrule=0.65pt,
    borderline west={3pt}{0pt}{GarnetRose},
    left=13pt,
    right=13pt,
    top=11pt,
    bottom=10pt,
    before skip=15pt,
    after skip=19pt,
    title={
      \textcolor{GarnetRose}{\bfseries\footnotesize
        \MakeUppercase{Review \there}}
      \ifstrempty{#1}{}{
        \hspace{0.55em}\textcolor{Graphite}{\bfseries #1}
      }
    },
    coltitle=Graphite,
    fonttitle=\normalsize,
    attach title to upper,
    after title={\par\vspace{8pt}},
  ]
  \normalfont
  \setlist[enumerate,1]{
    label=\textcolor{GarnetRose}{\bfseries\arabic*.},
    leftmargin=2em,
    labelsep=0.65em,
    itemsep=6pt,
    topsep=0pt,
    parsep=0pt
  }
}{
  \end{tcolorbox}
}

